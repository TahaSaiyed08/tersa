{
  "name": "tersa-lang",
  "displayName": "Tersa",
  "description": "Syntax highlighting for the Tersa programming language",
  "version": "0.1.0",
  "publisher": "tahasaiyed08",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/TahaSaiyed08/tersa.git" },
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{
      "id": "tersa",
      "aliases": ["Tersa", "tersa"],
      "extensions": [".tsa"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "tersa",
      "scopeName": "source.tersa",
      "path": "./syntaxes/tersa.tmLanguage.json"
    }]
  }
}
