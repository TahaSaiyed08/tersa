{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tersa",
  "scopeName": "source.tersa",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#declaration" },
    { "include": "#keyword" },
    { "include": "#constant" },
    { "include": "#number" },
    { "include": "#type" },
    { "include": "#call" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": { "name": "comment.line.number-sign.tersa", "match": "#.*$" },
    "string": {
      "patterns": [
        { "name": "string.quoted.raw.tersa", "begin": "r\"\"\"", "end": "\"\"\"" },
        { "name": "string.quoted.raw.tersa", "begin": "r\"", "end": "\"" },
        { "name": "string.quoted.triple.tersa", "begin": "\"\"\"", "end": "\"\"\"", "patterns": [{ "include": "#interp" }, { "include": "#escape" }] },
        { "name": "string.quoted.double.tersa", "begin": "\"", "end": "\"", "patterns": [{ "include": "#interp" }, { "include": "#escape" }] }
      ]
    },
    "escape": { "name": "constant.character.escape.tersa", "match": "\\\\(u\\{[0-9A-Fa-f]+\\}|.)|\\{\\{|\\}\\}" },
    "interp": {
      "name": "meta.interpolation.tersa",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.tersa" } },
      "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.tersa" } },
      "patterns": [{ "include": "$self" }]
    },
    "declaration": {
      "patterns": [
        { "match": "\\b(fn)\\s+(?:([A-Z]\\w*)\\.)?([A-Za-z_]\\w*)", "captures": { "1": { "name": "storage.type.function.tersa" }, "2": { "name": "entity.name.type.tersa" }, "3": { "name": "entity.name.function.tersa" } } },
        { "match": "\\b(type)\\s+([A-Z]\\w*)", "captures": { "1": { "name": "storage.type.tersa" }, "2": { "name": "entity.name.type.tersa" } } },
        { "match": "\\b(test)\\s+(?=\")", "captures": { "1": { "name": "keyword.other.test.tersa" } } }
      ]
    },
    "keyword": {
      "patterns": [
        { "name": "keyword.control.tersa", "match": "\\b(if|elif|else|match|for|in|while|break|continue|return|pass|assert)\\b" },
        { "name": "keyword.operator.logical.tersa", "match": "\\b(and|or|not|as)\\b" },
        { "name": "storage.modifier.tersa", "match": "\\b(var)\\b" },
        { "name": "keyword.other.tersa", "match": "\\b(use|extern|fn|type|test)\\b" }
      ]
    },
    "constant": {
      "patterns": [
        { "name": "constant.language.tersa", "match": "\\b(true|false|none)\\b" },
        { "name": "support.function.builtin.tersa", "match": "\\b(ok|err|some|print|panic)\\b(?=\\()" }
      ]
    },
    "number": { "name": "constant.numeric.tersa", "match": "\\b(0x[0-9A-Fa-f_]+|0b[01_]+|[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?)\\b" },
    "type": {
      "patterns": [
        { "name": "support.type.primitive.tersa", "match": "\\b(int|float|str|bool|dyn|never|set)\\b" },
        { "name": "entity.name.type.tersa", "match": "\\b[A-Z]\\w*\\b" }
      ]
    },
    "call": { "match": "\\b([a-z_]\\w*)\\s*(?=\\()", "captures": { "1": { "name": "entity.name.function.call.tersa" } } },
    "operator": { "name": "keyword.operator.tersa", "match": "=>|->|\\?\\?|\\.\\.=?|==|!=|<=|>=|\\*\\*|//|[-+*/%<>=!?|]" }
  }
}
