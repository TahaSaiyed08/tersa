type Shape = Circle(r: float) | Rect(w: float, h: float) | Triangle(a: float, b: float, c: float)

fn name(s: Shape):
    match s:
        Circle(_): "circle"
        Rect(_, _): "rect"
        Triangle(_, _, _): "triangle"

fn area(s: Shape):
    match s:
        Circle(r): pi * r * r
        Rect(w, h): w * h
        Triangle(a, b, c):
            p = (a + b + c) / 2
            sqrt(p * (p - a) * (p - b) * (p - c))

fn perimeter(s: Shape):
    match s:
        Circle(r): 2 * pi * r
        Rect(w, h): 2 * (w + h)
        Triangle(a, b, c): a + b + c

shapes = [Circle(1.0), Rect(3.0, 4.0), Triangle(3.0, 4.0, 5.0)]
for s in shapes:
    print("{name(s)}: area={area(s):.2f} perimeter={perimeter(s):.2f}")
print("largest: {name(shapes.max_by(area))}")
print("total area: {shapes.map(area).sum():.2f}")
